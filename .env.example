# Lynqx Environment Variables
# Скопируйте этот файл в .env и настройте значения

# === Сервер ===
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# === База данных ===
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lynqx
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public

# === WebSocket Gateway ===
WS_HEARTBEAT_INTERVAL=30000
WS_PING_TIMEOUT=60000
WS_MAX_RECONNECT_DELAY=5000

# === CORS ===
CORS_ORIGIN=*

# === Аутентификация ===
AUTH_TOKEN_PREFIX=lynqx_

# === Docker (для docker-compose) ===
APP_PORT=3000
